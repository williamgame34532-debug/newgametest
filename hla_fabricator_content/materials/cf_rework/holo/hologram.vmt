"UnlitGeneric"
{
	"$basetexture" "cf_rework/holo/scanlines"
	"$color2" "[0.22 0.85 1.0]"
	"$additive" "1"
	"$nocull" "1"
	"$model" "1"
	"$basetexturetransform" "center .5 .5 scale 1 6 rotate 0 translate 0 0"
	"Proxies"
	{
		"TextureScroll"
		{
			"texturescrollvar" "$basetexturetransform"
			"texturescrollrate" "0.12"
			"texturescrollangle" "90"
		}
	}
}
