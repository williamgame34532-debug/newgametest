"UnlitGeneric"
{
	// the glass of the Combine terminals: dark teal, a grid, scanlines, a slow glow band and a faint noise
	// (16 frames, 8 per second) — drawn as one material instead of hundreds of lines every frame
	"$basetexture" "hla/terminal/bg_anim"
	"$vertexcolor" "1"
	"$vertexalpha" "1"
	"$nocull" "1"
	"Proxies"
	{
		"AnimatedTexture"
		{
			"animatedtexturevar" "$basetexture"
			"animatedtextureframenumvar" "$frame"
			"animatedtextureframerate" "8"
		}
	}
}
