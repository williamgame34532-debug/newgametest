"UnlitGeneric"
{
	// Half-Life: Alyx materials/effects/combine_shield_layer2_temp: plasma, additive, tint 0.608,
	// scrolls sideways 0.01 per second (vr_complex, unlit, additive — ported as is)
	"$basetexture" "hla/forcefield/field_plasma"
	"$color2" "[0.17 0.17 0.17]"
	"$additive" "1"
	"$nocull" "1"
	"$vertexcolor" "1"
	"$vertexalpha" "1"
	"Proxies"
	{
		"TextureScroll"
		{
			"texturescrollvar" "$basetexturetransform"
			"texturescrollrate" "0.01"
			"texturescrollangle" "0"
		}
	}
}
