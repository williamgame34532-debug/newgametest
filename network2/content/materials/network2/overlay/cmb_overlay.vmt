"Refract"
{
	"$model" "1"
	"$translucent" 1
	"$refractamount" ".25"
	"$refracttint" "[1 1 1]"

	$envmap env_cubemap
	$envmaptint "[1 1 1]"

	"$dudvmap" "network2/overlay/combine_overlay_normal"
	"$normalmap" "network2/overlay/combine_overlay_normal"

	"$bumpframe" "0"

	"$REFRACTTINTTEXTURE" "network2/overlay/combine_overlay"

	"Proxies"
	{
		"AnimatedTexture"
		{
			"animatedtexturevar" "$refracttinttexture"
			"animatedtextureframenumvar" "$bumpframe"
			"animatedtextureframerate" 30.00
		}
	}
}
